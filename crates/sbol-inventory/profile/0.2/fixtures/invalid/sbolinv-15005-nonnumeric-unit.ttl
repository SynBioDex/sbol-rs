@prefix ex: <https://example.org/invalid-15005/> .
@prefix fac: <https://sbol.io/ns/facility#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:facility a sbol:TopLevel, fac:Facility ; sbol:displayId "facility" ; sbol:hasNamespace <https://example.org/invalid-15005> .
ex:zone a sbol:TopLevel, fac:Zone ; sbol:displayId "zone" ; sbol:hasNamespace <https://example.org/invalid-15005> ; fac:facility ex:facility ; fac:zoneKind fac:Room ; fac:isActive true ; fac:condition <https://example.org/invalid-15005/zone/value> .

<https://example.org/invalid-15005/zone/value>
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "value" ;
    fac:propertyKind ex:Label ;
    fac:textValue "ambient" ;
    fac:unit <http://qudt.org/vocab/unit/DEG_C> .
