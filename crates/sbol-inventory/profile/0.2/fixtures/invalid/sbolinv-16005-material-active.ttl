@prefix ex: <https://example.org/invalid-16005/> .
@prefix fac: <https://sbol.io/ns/facility#> .
@prefix inv: <https://sbol.io/ns/inventory#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:facility a sbol:TopLevel, fac:Facility ; sbol:displayId "facility" ; sbol:hasNamespace <https://example.org/invalid-16005> .
ex:design a sbol:Component ; sbol:displayId "design" ; sbol:hasNamespace <https://example.org/invalid-16005> ; sbol:type <https://identifiers.org/SBO:0000251> .

ex:lot
    a sbol:Implementation ;
    sbol:displayId "lot" ;
    sbol:hasNamespace <https://example.org/invalid-16005> ;
    sbol:built ex:design ;
    fac:materialKind inv:BacterialStock ;
    fac:facility ex:facility .
