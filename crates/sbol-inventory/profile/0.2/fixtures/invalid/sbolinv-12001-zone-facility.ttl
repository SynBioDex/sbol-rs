@prefix ex: <https://example.org/invalid-12001/> .
@prefix fac: <https://sbol.io/ns/facility#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:zone
    a sbol:TopLevel, fac:Zone ;
    sbol:displayId "zone" ;
    sbol:hasNamespace <https://example.org/invalid-12001> ;
    fac:zoneKind fac:Room ;
    fac:isActive true .
