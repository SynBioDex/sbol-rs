@prefix cap: <https://sbol.io/ns/capability#> .
@prefix ex: <https://example.org/invalid-13008/> .
@prefix fac: <https://sbol.io/ns/facility#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:facility a sbol:TopLevel, fac:Facility ; sbol:displayId "facility" ; sbol:hasNamespace <https://example.org/invalid-13008> .

ex:asset
    a sbol:TopLevel, fac:Asset ;
    sbol:displayId "asset" ;
    sbol:hasNamespace <https://example.org/invalid-13008> ;
    fac:facility ex:facility ;
    fac:assetKind fac:Instrument ;
    fac:isActive true ;
    fac:capability <https://example.org/invalid-13008/asset/first>, <https://example.org/invalid-13008/asset/second> .

<https://example.org/invalid-13008/asset/first>
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "first" ;
    fac:capabilityKind cap:ThermalCycling ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ManualControl ;
    fac:isActive true .

<https://example.org/invalid-13008/asset/second>
    a sbol:Identified, fac:CapabilityOffering ;
    sbol:displayId "second" ;
    fac:capabilityKind cap:ThermalCycling ;
    fac:qualification fac:Plannable ;
    fac:controlMode fac:ManualControl ;
    fac:isActive true .
