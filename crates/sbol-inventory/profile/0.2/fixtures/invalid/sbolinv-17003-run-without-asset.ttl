@prefix ex: <https://example.org/invalid-17003/> .
@prefix fac: <https://draggon.org/ns/facility#> .
@prefix inv: <https://draggon.org/ns/inventory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:facility a sbol:TopLevel, fac:Facility ; sbol:displayId "facility" ; sbol:hasNamespace <https://example.org/invalid-17003> .
ex:design a sbol:Component ; sbol:displayId "design" ; sbol:hasNamespace <https://example.org/invalid-17003> ; sbol:type <https://identifiers.org/SBO:0000251> .
ex:lot a sbol:Implementation ; sbol:displayId "lot" ; sbol:hasNamespace <https://example.org/invalid-17003> ; sbol:built ex:design ; fac:materialKind inv:BacterialStock ; fac:facility ex:facility ; fac:isActive true .

ex:run
    a sbol:TopLevel, prov:Activity ;
    sbol:displayId "run" ;
    sbol:hasNamespace <https://example.org/invalid-17003> ;
    prov:qualifiedUsage <https://example.org/invalid-17003/run/input_usage> .

<https://example.org/invalid-17003/run/input_usage>
    a sbol:Identified, prov:Usage ;
    sbol:displayId "input_usage" ;
    prov:entity ex:lot ;
    prov:hadRole fac:RunInputMaterial .
