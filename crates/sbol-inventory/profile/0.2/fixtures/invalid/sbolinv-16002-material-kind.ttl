@prefix ex: <https://example.org/invalid-16002/> .
@prefix fac: <https://draggon.org/ns/facility#> .
@prefix inv: <https://draggon.org/ns/inventory#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:facility a sbol:TopLevel, fac:Facility ; sbol:displayId "facility" ; sbol:hasNamespace <https://example.org/invalid-16002> .
ex:design a sbol:Component ; sbol:displayId "design" ; sbol:hasNamespace <https://example.org/invalid-16002> ; sbol:type <https://identifiers.org/SBO:0000251> .

ex:lot
    a sbol:Implementation ;
    sbol:displayId "lot" ;
    sbol:hasNamespace <https://example.org/invalid-16002> ;
    sbol:built ex:design ;
    fac:materialKind inv:BacterialStock, inv:ProcuredMaterial ;
    fac:facility ex:facility ;
    fac:isActive true .
