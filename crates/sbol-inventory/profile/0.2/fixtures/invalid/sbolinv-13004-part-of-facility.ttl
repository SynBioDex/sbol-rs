@prefix ex: <https://example.org/invalid-13004/> .
@prefix fac: <https://sbol.io/ns/facility#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:first_facility a sbol:TopLevel, fac:Facility ; sbol:displayId "first_facility" ; sbol:hasNamespace <https://example.org/invalid-13004> .
ex:second_facility a sbol:TopLevel, fac:Facility ; sbol:displayId "second_facility" ; sbol:hasNamespace <https://example.org/invalid-13004> .

ex:parent
    a sbol:TopLevel, fac:Asset ;
    sbol:displayId "parent" ;
    sbol:hasNamespace <https://example.org/invalid-13004> ;
    fac:locatedIn ex:first_room ;
    fac:assetKind fac:Instrument ;
    fac:isActive true .

ex:child
    a sbol:TopLevel, fac:Asset ;
    sbol:displayId "child" ;
    sbol:hasNamespace <https://example.org/invalid-13004> ;
    fac:locatedIn ex:second_room ;
    fac:assetKind fac:FunctionalUnit ;
    fac:partOf ex:parent ;
    fac:isActive true .

ex:first_room a sbol:TopLevel, fac:Zone ; sbol:displayId "first_room" ; sbol:hasNamespace <https://example.org/invalid-13004> ; fac:facility ex:first_facility ; fac:zoneKind fac:Room ; fac:isActive true .

ex:second_room a sbol:TopLevel, fac:Zone ; sbol:displayId "second_room" ; sbol:hasNamespace <https://example.org/invalid-13004> ; fac:facility ex:second_facility ; fac:zoneKind fac:Room ; fac:isActive true .
