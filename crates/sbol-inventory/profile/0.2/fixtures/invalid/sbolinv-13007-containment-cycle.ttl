@prefix ex: <https://example.org/invalid-13007/> .
@prefix fac: <https://draggon.org/ns/facility#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:facility a sbol:TopLevel, fac:Facility ; sbol:displayId "facility" ; sbol:hasNamespace <https://example.org/invalid-13007> .

ex:first
    a sbol:TopLevel, fac:Asset ;
    sbol:displayId "first" ;
    sbol:hasNamespace <https://example.org/invalid-13007> ;
    fac:facility ex:facility ;
    fac:assetKind fac:Instrument ;
    fac:partOf ex:second ;
    fac:isActive true .

ex:second
    a sbol:TopLevel, fac:Asset ;
    sbol:displayId "second" ;
    sbol:hasNamespace <https://example.org/invalid-13007> ;
    fac:facility ex:facility ;
    fac:assetKind fac:Container ;
    fac:locatedIn ex:first ;
    fac:isActive true .
