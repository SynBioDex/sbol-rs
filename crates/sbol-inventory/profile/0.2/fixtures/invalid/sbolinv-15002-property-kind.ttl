@prefix ex: <https://example.org/invalid-15002/> .
@prefix fac: <https://draggon.org/ns/facility#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:facility a sbol:TopLevel, fac:Facility ; sbol:displayId "facility" ; sbol:hasNamespace <https://example.org/invalid-15002> .
ex:zone a sbol:TopLevel, fac:Zone ; sbol:displayId "zone" ; sbol:hasNamespace <https://example.org/invalid-15002> ; fac:facility ex:facility ; fac:zoneKind fac:Room ; fac:isActive true ; fac:condition <https://example.org/invalid-15002/zone/value> .

<https://example.org/invalid-15002/zone/value>
    a sbol:Identified, fac:PropertyValue ;
    sbol:displayId "value" ;
    fac:integerValue 20 .
