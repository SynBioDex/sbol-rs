@prefix ex: <https://example.org/invalid-13006/> .
@prefix fac: <https://sbol.io/ns/facility#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:facility a sbol:TopLevel, fac:Facility ; sbol:displayId "facility" ; sbol:hasNamespace <https://example.org/invalid-13006> .

ex:container
    a sbol:TopLevel, fac:Asset ;
    sbol:displayId "container" ;
    sbol:hasNamespace <https://example.org/invalid-13006> ;
    fac:facility ex:facility ;
    fac:assetKind fac:Container ;
    fac:allowedPosition "" ;
    fac:isActive true .
