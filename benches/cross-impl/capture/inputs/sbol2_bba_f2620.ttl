	<http://purl.org/dc/terms/title> "luxr" ;
	<http://purl.org/dc/terms/description> "luxR repressor/activator,  (no LVA?)" ;
	<http://purl.org/dc/terms/created> "2003-01-31T12:00:00Z" ;
	<http://purl.org/dc/terms/modified> "2015-08-31T04:07:23Z" ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableProvenance> "<em>V. fischeri</em> <genbank>AF170104</genbank>" ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel> <https://synbiohub.org/public/igem/BBa_C0062/1> ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#ownedBy> <https://synbiohub.org/user/james> , <https://synbiohub.org/user/myers> ;
	<http://wiki.synbiohub.org/wiki/Terms/igem#partStatus> "Released HQ 2013" ;
	<http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableDescription> "In complex with HSL, LuxR binds to the Lux promoter, activating transcription      from Pr <bb_part>BBa_R0062</bb_part>, and repressing transcription from Pl <bb_part>BBa_R0063</bb_part>.   <p>The lux cassette of V. fischeri contains a left and a right promoter. The      right promoter gives weak constitutive expression of downstream genes.This      expression is up-regulated by the action of the Lux activator, LuxR complexed      to HSL. Two molecules of LuxR protein form a complex with two molecules the      signalling compound homoserine lactone (HSL). This complex binds to a palindromic      site on the promoter, increasing the rate of transcription.</p>" ;
	<http://wiki.synbiohub.org/wiki/Terms/igem#discontinued> "false" ;
	<http://wiki.synbiohub.org/wiki/Terms/igem#dominant> "true" ;
	<http://wiki.synbiohub.org/wiki/Terms/igem#experience> <http://wiki.synbiohub.org/wiki/Terms/igem#experience/None> ;
