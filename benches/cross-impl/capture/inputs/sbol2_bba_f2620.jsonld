sDerivedFrom":[{"@id":"http://parts.igem.org/Part:BBa_B0012"}],"http://www.w3.org/ns/prov#wasGeneratedBy":[{"@id":"https://synbiohub.org/public/igem/igem2sbol/1"}],"http://purl.org/dc/terms/title":[{"@value":"BBa_B0012"}],"http://purl.org/dc/terms/description":[{"@value":"TE from coliphageT7"}],"http://purl.org/dc/terms/created":[{"@value":"2003-01-31T12:00:00Z"}],"http://purl.org/dc/terms/modified":[{"@value":"2015-08-31T04:07:20Z"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableProvenance":[{"@value":"Derived from the TE terminator of T7 bacteriophage between Genes 1.3 and 1.4      <genbank>V01146</genbank>."}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_B0012/1"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#ownedBy":[{"@id":"https://synbiohub.org/user/james"},{"@id":"https://synbiohub.org/user/myers"}],"http://wiki.synbiohub.org/wiki/Terms/igem#partStatus":[{"@value":"Released HQ 2013"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableDescription":[{"@value":"Transcription terminator for the <i>E.coli</i> RNA polymerase."}],"http://wiki.synbiohub.org/wiki/Terms/igem#discontinued":[{"@value":"false"}],"http://wiki.synbiohub.org/wiki/Terms/igem#dominant":[{"@value":"false"}],"http://wiki.synbiohub.org/wiki/Terms/igem#experience":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#experience/Fails"}],"http://wiki.synbiohub.org/wiki/Terms/igem#group_u_list":[{"@value":"_1_"}],"http://wiki.synbiohub.org/wiki/Terms/igem#m_user_id":[{"@value":"0"}],"http://wiki.synbiohub.org/wiki/Terms/igem#owner_id":[{"@value":"24"}],"http://wiki.synbiohub.org/wiki/Terms/igem#owning_group_id":[{"@value":"7"}],"http://wiki.synbiohub.org/wiki/Terms/igem#sampleStatus":[{"@value":"In stock"}],"http://wiki.synbiohub.org/wiki/Terms/igem#status":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#status/Available"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#bookmark":[{"@value":"false"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableNotes":[{"@value":"<P> <P>Suggested by Sri Kosuri and Drew Endy as a high efficiency terminator. The      5' end cutoff was placed immediately after the TAA stop codon and the 3' end      cutoff was placed just prior to the RBS of Gene 1.4 (before AAGGAG).<P> Use anywhere transcription should be stopped when the gene of interest is upstream of this terminator."}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#star":[{"@value":"false"}],"http://purl.org/dc/elements/1.1/creator":[{"@value":"Reshma Shetty"}],"http://sbols.org/v2#type":[{"@id":"http://www.biopax.org/release/biopax-level3.owl#DnaRegion"}],"http://sbols.org/v2#role":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#partType/Terminator"},{"@id":"http://identifiers.org/so/SO:0000141"}]},{"@id":"https://synbiohub.org/public/igem/BBa_B0012/annotation7020/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#SequenceAnnotation"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_B0012/annotation7020"}],"http://sbols.org/v2#displayId":[{"@value":"annotation7020"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://purl.org/dc/terms/title":[{"@value":"BBa_B0012"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_B0012/1"}]},{"@id":"https://synbiohub.org/public/igem/BBa_B0012/annotation7020/range7020/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#Range"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_B0012/annotation7020/range7020"}],"http://sbols.org/v2#displayId":[{"@value":"range7020"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_B0012/1"}],"http://wiki.synbiohub.org/wiki/Terms/igem#direction":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#direction/forward"}],"http