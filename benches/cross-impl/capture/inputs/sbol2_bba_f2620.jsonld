ation"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_R0040/annotation1986787"}],"http://sbols.org/v2#displayId":[{"@value":"annotation1986787"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://purl.org/dc/terms/title":[{"@value":"-10"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_R0040/1"}]},{"@id":"https://synbiohub.org/public/igem/BBa_R0040/annotation1986787/range1986787/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#Range"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_R0040/annotation1986787/range1986787"}],"http://sbols.org/v2#displayId":[{"@value":"range1986787"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_R0040/1"}],"http://wiki.synbiohub.org/wiki/Terms/igem#direction":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#direction/forward"}],"http://sbols.org/v2#start":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"43"}],"http://sbols.org/v2#end":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"48"}],"http://sbols.org/v2#orientation":[{"@id":"http://sbols.org/v2#inline"}]},{"@id":"https://synbiohub.org/public/igem/BBa_R0040/annotation1986787/1","http://sbols.org/v2#location":[{"@id":"https://synbiohub.org/public/igem/BBa_R0040/annotation1986787/range1986787/1"}],"http://sbols.org/v2#role":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#feature/promoter"},{"@id":"http://identifiers.org/so/SO:0000167"}]},{"@id":"https://synbiohub.org/public/igem/BBa_R0040/1","http://sbols.org/v2#sequenceAnnotation":[{"@id":"https://synbiohub.org/public/igem/BBa_R0040/annotation1986787/1"}],"http://sbols.org/v2#sequence":[{"@id":"https://synbiohub.org/public/igem/BBa_R0040_sequence/1"}]},{"@id":"https://synbiohub.org/public/igem/BBa_C0062/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#ComponentDefinition"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_C0062"}],"http://sbols.org/v2#displayId":[{"@value":"BBa_C0062"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"http://parts.igem.org/Part:BBa_C0062"}],"http://www.w3.org/ns/prov#wasGeneratedBy":[{"@id":"https://synbiohub.org/public/igem/igem2sbol/1"}],"http://purl.org/dc/terms/title":[{"@value":"luxr"}],"http://purl.org/dc/terms/description":[{"@value":"luxR repressor/activator,  (no LVA?)"}],"http://purl.org/dc/terms/created":[{"@value":"2003-01-31T12:00:00Z"}],"http://purl.org/dc/terms/modified":[{"@value":"2015-08-31T04:07:23Z"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableProvenance":[{"@value":"<em>V. fischeri</em> <genbank>AF170104</genbank>"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_C0062/1"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#ownedBy":[{"@id":"https://synbiohub.org/user/james"},{"@id":"https://synbiohub.org/user/myers"}],"http://wiki.synbiohub.org/wiki/Terms/igem#partStatus":[{"@value":"Released HQ 2013"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableDescription":[{"@value":"In complex with HSL, LuxR binds to the Lux promoter, activating transcription      from Pr <bb_part>BBa_R0062</bb_part>, and repressing transcription from Pl <bb_part>BBa_R0063</bb_part>.   <p>The lux cassette of V. fischeri contains a left and a right promoter. The      right promoter gives weak constitutive expression of downstream genes.This      expression is up-regulated by the action of the Lux activator, LuxR complexed      to HSL. Two molecules of LuxR protein form a complex with two molecules the      signalling compound homoserine lactone (HSL). This complex binds to a palindromic      site on the promoter, increasing the rate of transcription.</p>"}],"http://wiki.synbiohub.org/wiki/Terms/igem#discontinued":[{"@value":"false"}],"http://wiki.synbiohub.org/wiki/Terms/igem#dominant":[{"@value":"true"}],"http://wiki.synbiohub.org/wiki/Terms/igem#experience":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#experience/None"}],"http://wiki.synbiohub.org/wiki/Terms/igem#group_u_list":[{"@value":"_1_"}],"http://wiki.synbiohub.org/wiki/Terms/igem#m_user_id":[{"@value":"0"}],"http://wiki.synbiohub.org/wiki/Terms/igem#owner_id":[{"@value":"24"}],"http://wiki.synbiohub.org/wiki/Terms/igem#owning_group_id":[{"@value":"7"}],"http://wiki.synbiohub.org/wiki/Terms/igem#sampleStatus":[{"@value":"In stock"}],"http://wiki.synbiohub.org/wiki/Terms/igem#status":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#status/Available"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#bookmark":[{"@value":"false"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableNotes":[{"@value":"<P> <P>2 silent point mutants were introduced in the coding sequence to remove internal      XbaI and PstI sites. Mutation sites were chosen to replace codons commonly      used in <em>E. coli</em> with codons used at a similar frequency. <P>"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#star":[{"@value":"true"}],"http://purl.org/dc/elements/1.1/creator":[{"@value":"Vinay S Mahajan, Voichita D. Marinescu, Brian Chow, Alexander D Wissner-Gross and Peter Carr"}],"http://sbols.org/v2#type":[{"@id":"http://www.biopax.org/release/biopax-level3.owl#DnaRegion"}],"http://sbols.org/v2#role":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#partType/Coding"},{"@id":"http://identifiers.org/so/SO:0000316"}]},{"@id":"https://synbiohub.org/public/igem/BBa_C0062/annotation1766/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#SequenceAnnotation"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_C0062/annotation1766"}],"http://sbols.org/v2#displayId":[{"@value":"annotation1766"}],"http://sbols.org