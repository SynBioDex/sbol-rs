nbiohub.org/public/igem/BBa_C0062/1"}]},{"@id":"https://synbiohub.org/public/igem/BBa_C0062/annotation2213986/range2213986/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#Range"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_C0062/annotation2213986/range2213986"}],"http://sbols.org/v2#displayId":[{"@value":"range2213986"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_C0062/1"}],"http://wiki.synbiohub.org/wiki/Terms/igem#direction":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#direction/forward"}],"http://sbols.org/v2#start":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"757"}],"http://sbols.org/v2#end":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"781"}],"http://sbols.org/v2#orientation":[{"@id":"http://sbols.org/v2#inline"}]},{"@id":"https://synbiohub.org/public/igem/BBa_C0062/annotation2213986/1","http://sbols.org/v2#location":[{"@id":"https://synbiohub.org/public/igem/BBa_C0062/annotation2213986/range2213986/1"}],"http://sbols.org/v2#role":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#feature/barcode"},{"@id":"http://identifiers.org/so/SO:0000807"}]},{"@id":"https://synbiohub.org/public/igem/BBa_C0062/1","http://sbols.org/v2#sequenceAnnotation":[{"@id":"https://synbiohub.org/public/igem/BBa_C0062/annotation2213986/1"}],"http://sbols.org/v2#sequence":[{"@id":"https://synbiohub.org/public/igem/BBa_C0062_sequence/1"}]},{"@id":"https://synbiohub.org/public/igem/BBa_R0062/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#ComponentDefinition"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_R0062"}],"http://sbols.org/v2#displayId":[{"@value":"BBa_R0062"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"http://parts.igem.org/Part:BBa_R0062"}],"http://www.w3.org/ns/prov#wasGeneratedBy":[{"@id":"https://synbiohub.org/public/igem/igem2sbol/1"}],"http://purl.org/dc/terms/title":[{"@value":"lux pR"}],"http://purl.org/dc/terms/description":[{"@value":"Promoter (luxR & HSL regulated -- lux pR)"}],"http://purl.org/dc/terms/created":[{"@value":"2003-01-31T12:00:00Z"}],"http://purl.org/dc/terms/modified":[{"@value":"2015-05-08T01:14:15Z"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableProvenance":[{"@value":"<em>V. fischeri</em>"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_R0062/1"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#ownedBy":[{"@id":"https://synbiohub.org/user/james"},{"@id":"https://synbiohub.org/user/myers"}],"http://wiki.synbiohub.org/wiki/Terms/igem#partStatus":[{"@value":"Released HQ 2013"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableDescription":[{"@value":"Promoter activated by LuxR in concert with HSL</p>   <p>The lux cassette of V. fischeri contains a left and a right promoter. The      right promoter gives weak constitutive expression of downstream genes.This      expression is up-regulated by the action of the LuxR activator protein complexed      with the autoinducer, 3-oxo-hexanoyl-HSL. Two molecules of LuxR protein form      a complex with two molecules of the signalling compound homoserine lactone      (HSL). This complex binds to a palindromic site on the promoter, increasing      the rate of transcription."}],"http://wiki.synbiohub.org/wiki/Terms/igem#discontinued":[{"@value":"false"}],"http://wiki.synbiohub.org/wiki/Terms/igem#dominant":[{"@value":"true"}],"http://wiki.synbiohub.org/wiki/Terms/igem#experience":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#experience/None"}],"http://wiki.synbiohub.org/wiki/Terms/igem#group_u_list":[{"@value":"_1_"}],"http://wiki.synbiohub.org/wiki/Terms/igem#m_user_id":[{"@value":"0"}],"http://wiki.synbiohub.org/wiki/Terms/igem#owner_id":[{"@value":"24"}],"http://wiki.synbiohub.org/wiki/Terms/igem#owning_group_id":[{"@value":"7"}],"http://wiki.synbiohub.org/wiki/Terms/igem#sampleStatus":[{"@value":"In stock"}],"http://wiki.synbiohub.org/wiki/Terms/igem#status":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#status/Available"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#bookmark":[{"@value":"false"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#mutableNotes":[{"@value":"<P> <P>This promoter is based on the <em>Vibrio fischeri </em>quorum sensing gene promoters. Two genes LuxI and LuxR and transcribed in opposite directions as shown below. The original sequence from which the parts <bb_part>BBa_R0062</bb_part> and <bb_part>BBa_R0063</bb_part> were derived is shown in the picture below.  <p><img src=\"<bb_file>Image1.gif</bb_file>\" width=\"614\" height=\"362\"><P>"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#star":[{"@value":"true"}],"http://purl.org/dc/elements/1.1/creator":[{"@value":"Vinay S Mahajan, Voichita D. Marinescu, Brian Chow, Alexander D Wissner-Gross and Peter Carr"}],"http://sbols.org/v2#type":[{"@id":"http://www.biopax.org/release/biopax-level3.owl#DnaRegion"}],"http://sbols.org/v2#role":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#partType/Regulatory"},{"@id":"http://identifiers.org/so/SO:0000167"}]},{"@id":"https://synbiohub.org/public/igem/BBa_R0062/annotation7070/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#SequenceAnnotation"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_R0062/annotation7070"}],"http://sbols.org/v2#displayId":[{"@value":"annotation7070"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://purl.org/dc/terms/title":[{"@value":"BBa_R0062"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_R0062/1"}]},{"@id":"https://synbiohub.org/public/igem/BBa_R0062/annotation7070/range7070/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#Range"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_R0062/annotation7070/range7070"}],"http://sbols.org/v2#displayId":[{"@value":"range7070"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_R0062/1"}],"http://wiki.synbiohub.org/wiki/Terms/igem#direction":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#direction/forward"}],"http://sbols.org/v2#start":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"1"}],"http://sbols.org/v2#end":[{"@type":"http://www.w3.org/2001/XMLSchema#integer","@value":"55"}],"http://sbols.org/v2#orientation":[{"@id":"http://sbols.org/v2#inline"}]},{"@id":"https://synbiohub.org/public/igem/BBa_R0062/annotation7070/1","http://sbols.org/v2#location":[{"@id":"https://synbiohub.org/public/igem/BBa_R0062/annotation7070/range7070/1"}],"http://sbols.org/v2#role":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#feature/BioBrick"},{"@id":"http://identifiers.org/so/SO:0000804"}]},{"@id":"https://synbiohub.org/public/igem/BBa_R0062/1","http://sbols.org/v2#sequenceAnnotation":[{"@id":"https://synbiohub.org/public/igem/BBa_R0062/annotation7070/1"}]},{"@id":"https://synbiohub.org/public/igem/BBa_R0062/annotation2045/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#SequenceAnnotation"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_R0062/annotation2045"}],"http://sbols.org/v2#displayId":[{"@value":"annotation2045"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://purl.org/dc/terms/title":[{"@value":"LuxR/HSL"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_R0062/1"}]},{"@id":"https://synbiohub.org/public/igem/BBa_R0062/annotation2045/range2045/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://s