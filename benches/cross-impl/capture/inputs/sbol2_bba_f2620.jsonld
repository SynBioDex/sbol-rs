BS by upstream and downstream elements      in the +50 to -50 region, as such structures will greatly affect the strength      of the RBS.\n\nContact info for this part: <a href=\"mailto:(bchow@media.mit.edu)\">Brian Chow</a>"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#star":[{"@value":"true"}],"http://purl.org/dc/elements/1.1/creator":[{"@value":"Vinay S Mahajan, Voichita D. Marinescu, Brian Chow, Alexander      D Wissner-Gross and Peter Carr IAP, 2003."}],"http://sbols.org/v2#type":[{"@id":"http://www.biopax.org/release/biopax-level3.owl#DnaRegion"}],"http://sbols.org/v2#role":[{"@id":"http://identifiers.org/so/SO:0000139"},{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#partType/RBS"}]},{"@id":"https://synbiohub.org/public/igem/BBa_B0034/annotation23325/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#SequenceAnnotation"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_B0034/annotation23325"}],"http://sbols.org/v2#displayId":[{"@value":"annotation23325"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://purl.org/dc/terms/title":[{"@value":"conserved"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_B0034/1"}]},{"@id":"https://synbiohub.org/public/igem/BBa_B0034/annotation23325/range23325/1","http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"@id":"http://sbols.org/v2#Range"}],"http://sbols.org/v2#persistentIdentity":[{"@id":"https://synbiohub.org/public/igem/BBa_B0034/annotation23325/range23325"}],"http://sbols.org/v2#displayId":[{"@value":"range23325"}],"http://sbols.org/v2#version":[{"@value":"1"}],"http://wiki.synbiohub.org/wiki/Terms/synbiohub#topLevel":[{"@id":"https://synbiohub.org/public/igem/BBa_B0034/1"}],"http://wiki.synbiohub.org/wiki/Terms/igem#direction":[{"@id":"http://wiki.synbiohub.org/wiki/Terms/igem#direction/forward"}],"http://sbols.org/v2#start":[{"@type":"http://www.w3.org/2001/XMLSchema#integer",